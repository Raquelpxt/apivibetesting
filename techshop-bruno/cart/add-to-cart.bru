meta {
  name: Add to Cart
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/cart
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "productId": 1,
    "quantity": 2
  }
}

assert {
  res.status: eq 201
  res.body.items: isDefined
}
